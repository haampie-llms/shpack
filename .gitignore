# Outputs of a bootstrap run, at their default locations (see shpack.conf.example)
/store/
/tmp/

# source tarballs: not committed (too large); fetched + verified by
# fetch-distfiles.sh, or shipped with the tree.
/distfiles/

# local configuration (copy shpack.conf.example)
/shpack.conf

# stage0-posix's own build outputs under seed/ are covered by the .gitignore
# files it ships (seed/*/bin, seed/*/artifact).
